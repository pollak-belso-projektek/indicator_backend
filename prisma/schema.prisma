  lemorzsolodas                   Lemorzsolodas[]
  muhelyiskola                    Muhelyiskola[]
  munkavallalokElismeresek        MunkavallalokElismeresek[]
  nszfhMeresek                    nszfhMeresek[]
  oktatoAdatszolg                 OktatoAdatszolg[]
  osztalyAdatszolg                OsztalyAdatszolg[]
  OktatoEgyebTev                  OktatoEgyebTev[]
  sajatosNevelesuTanulok          SajatosNevelesuTanulok[]
  szakkepzesiMunkaszerzodesAranya SzakkepzesiMunkaszerzodesAranya[]
  szakmaiRendezvenyek             SzakmaiRendezvenyek[]
  szakmaiTovabbkepzes             SzakmaiTovabbkepzes[]
  szakmaiVizsgaEredmenyek         SzakmaiVizsgaEredmenyek[]
  tanuloAdatszolg                 TanuloAdatszolg[]
  users                           User[]                            @relation("AlapadatokUsers")
  versenyek                       versenyek[]
  vizsgaeredmenyek                VizsgaEredmenyek[]
  dualisKepzohelyek               DualisKepzohelyek[]
  innovaciosTevekenysegek         InnovaciosTevekenysegek[]
  palyazatok                      Palyazatok[]
  tanulmanyiEredmeny              TanulmanyiEredmeny[]
  szakkepzesZolditese             SzakkepzesZolditese[]
